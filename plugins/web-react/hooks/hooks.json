{
  "description": "React/TS/Tailwind checks: UI conventions on each edit, and a colocated a11y test for each new component.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/check-ui-conventions.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/check-new-component-tests.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
