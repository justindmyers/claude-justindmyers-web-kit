{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "extraKnownMarketplaces": {
    "justindmyers-web-kit": {
      "source": { "source": "github", "repo": "justindmyers/claude-justindmyers-web-kit" }
    }
  },
  "enabledPlugins": {
    "web-core@justindmyers-web-kit": true,
    "web-react@justindmyers-web-kit": true
  },
  "permissions": {
    "allow": [
      "Bash(pnpm test:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": ["Read(./.env)", "Read(./.env.*)"]
  }
}
